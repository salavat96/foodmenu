# Токен бота из @BotFather
BOT_TOKEN=123456:your-telegram-bot-token

# По умолчанию SQLite для локальной разработки.
# Для продакшена: postgresql+asyncpg://user:password@host:5432/foodmenu
DATABASE_URL=sqlite+aiosqlite:///./foodmenu.db

# Часовой пояс по умолчанию для новых пользователей
DEFAULT_TIMEZONE=Europe/Moscow

# Ключ Anthropic API (console.anthropic.com) — нужен для генерации рецептов
# "по описанию", когда в локальной базе не нашлось похожего блюда.
# Если не задан, бот просто скажет, что рецепт не найден, без обращения к API.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# Защита от перегрузки при росте числа пользователей:
# сколько запросов к ИИ одновременно и сколько на одного пользователя в сутки.
AI_MAX_CONCURRENT_REQUESTS=5
AI_DAILY_LIMIT_PER_USER=10
